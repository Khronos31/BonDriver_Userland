; BonDriver_Siano sample configuration (common client form).
; Copy to the directory containing BonDriver_Siano.so/.dll/.dylib and rename it
; to BonDriver_Siano.ini.  Relative paths resolve against this file's directory.
; Exactly one [group.NAME] is accepted per file.

[common]
lock_dir = /run/bondriver-userland
tune_timeout_ms = 4000
stop_timeout_ms = 5000
kill_timeout_ms = 2000
buffer_limit_bytes = 8388608
diagnostics = stderr

; One executable + daemon runtime namespace.  The label is not a product type.
[client.siano]
cli_path = /usr/local/bin/siano-ts
; Directory shared with the already-running sianod.  The daemon is not started
; or stopped by this library.
runtime_dir = /run/siano-userland

; Siano exposes receiver 0 only.  Use one instance per physical PX-S1UD;
; remove the second entry when only one unit is connected.  instance tokens are
; chosen when sianod is started and must be lowercase.
[group.Siano]
tuner_name = Siano
channel_table = BonDriver_Siano.channels.tsv
receivers = siano:s1ud_a:0:T; siano:s1ud_b:0:T
