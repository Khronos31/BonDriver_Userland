; BonDriver_Userland sample configuration.
; Copy this file next to BonDriver_Userland.so/.dll/.dylib as
; BonDriver_Userland.ini.  Relative paths resolve against this file's directory.
;
; The library itself is one binary.  For EDCB, copy the same binary to
; BonDriver_Userland_T / _S / _TS (and to _T_0 etc. for Proxy) and give each
; copy a different basename; the basename selects one [group.NAME] here.
;
; All BonDriver copies/INI that reference the same receiver must share the same
; lock_dir.  A different lock_dir disables cross-INI pre-exclusion.
[common]
lock_dir = /run/bondriver-userland
tune_timeout_ms = 10000
stop_timeout_ms = 5000
kill_timeout_ms = 2000
buffer_limit_bytes = 8388608
diagnostics = stderr

; A client is one *-ts executable and one daemon runtime namespace.  The label
; is not a product type; it is only the name used by receivers below.
[client.px4]
cli_path = /usr/local/bin/px4-ts
runtime_dir = /run/px4-userland

[client.siano]
cli_path = /usr/local/bin/siano-ts
runtime_dir = /run/siano-userland

[client.asicen]
cli_path = /usr/local/bin/asicen-ts
runtime_dir = /run/asicen-userland

[client.pix]
cli_path = /usr/local/bin/pix-ts
runtime_dir = /run/pix-userland

; torne is a planned client: torne-ts / receiver 0 / ISDB-T only.  The daemon
; listener and real reception are not implemented yet, so this group does not
; work until torne-userland gains them.
[client.torne]
cli_path = /usr/local/bin/torne-ts
runtime_dir = /run/torne-userland

; T12 / S8 / TS3 = 23 receivers.  This is a representative combination, not a
; verified all-at-once operation.  Use lowercase instance tokens.
; receivers = client:instance:receiver:systems

; Terrestrial-only group (12).  EDCB Count = 12.
[group.BonDriver_Userland_T]
tuner_name = Userland-T
channel_table = channels-ground.example.tsv
receivers = siano:s1ud_a:0:T; siano:s1ud_b:0:T; px4:q3u4:2:T; px4:q3u4:3:T; px4:q3u4:6:T; px4:q3u4:7:T; px4:s1ur:0:T; asicen:w3u3:1:T; asicen:w3u3:3:T; asicen:w3u2:1:T; asicen:w3u2:3:T; torne:torne0:0:T

; BS/110-degree CS-only group (8).  EDCB Count = 8.
[group.BonDriver_Userland_S]
tuner_name = Userland-S
channel_table = channels-satellite.example.tsv
receivers = px4:q3u4:0:S; px4:q3u4:1:S; px4:q3u4:4:S; px4:q3u4:5:S; asicen:w3u3:0:S; asicen:w3u3:2:S; asicen:w3u2:0:S; asicen:w3u2:2:S

; T/S hybrid group (3).  EDCB Count = 3.  Do not also count these receivers
; in the T or S groups.
[group.BonDriver_Userland_TS]
tuner_name = Userland-TS
channel_table = channels-all.example.tsv
receivers = px4:m1ur:0:TS; pix:dt181:0:TS; pix:dt295:0:TS

; TVTest/tsdump group with all 23 receivers.  EDCB should use the T/S/TS groups
; above instead, because EDCB assumes every Count in one group can receive every
; channel in that group's table.
[group.BonDriver_Userland]
tuner_name = Userland
channel_table = channels-all.example.tsv
receivers = siano:s1ud_a:0:T; siano:s1ud_b:0:T; px4:q3u4:0:S; px4:q3u4:1:S; px4:q3u4:2:T; px4:q3u4:3:T; px4:q3u4:4:S; px4:q3u4:5:S; px4:q3u4:6:T; px4:q3u4:7:T; px4:s1ur:0:T; px4:m1ur:0:TS; asicen:w3u3:0:S; asicen:w3u3:1:T; asicen:w3u3:2:S; asicen:w3u3:3:T; asicen:w3u2:0:S; asicen:w3u2:1:T; asicen:w3u2:2:S; asicen:w3u2:3:T; pix:dt181:0:TS; pix:dt295:0:TS; torne:torne0:0:T
