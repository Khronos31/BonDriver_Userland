; BonDriver_PX4 sample configuration.
; Copy to the directory containing BonDriver_PX4.so/.dll/.dylib and rename it
; to BonDriver_PX4.ini.  Relative paths resolve against this file's directory.

[common]
tuner_name = PX4
cli_path = /usr/local/bin/px4-ts
channel_table = BonDriver_PX4.channels.tsv
tune_timeout_ms = 10000
stop_timeout_ms = 5000
kill_timeout_ms = 2000
buffer_limit_bytes = 8388608
diagnostics = stderr

[px4]
; Directory of the running px4d runtime (canonicalised).
runtime_dir = /run/px4-userland

; Fixed form: one instance + one receiver + its systems (T, S or TS).
instance = tok
receiver = 0
systems = TS

; Pool form (choose a free receiver; dedicated before hybrid):
; receivers = tok:0:T;tok:1:S;tok:2:TS

; LNB voltage is off by default. Setting 15 additionally requires
; allow_lnb_15 = 1 and a daemon started with --allow-lnb-power.
lnb_voltage = 0
allow_lnb_15 = 0
